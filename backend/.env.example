# OpenAI
OPENAI_API_KEY=sk-...

# Tavily (web search) — https://app.tavily.com
TAVILY_API_KEY=tvly-...

# LinkedIn OAuth2 — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...
LINKEDIN_ACCESS_TOKEN=...   # long-lived token after OAuth2 flow
LINKEDIN_PERSON_URN=urn:li:person:...   # your LinkedIn person URN

# Buffer — https://buffer.com/developers/api
BUFFER_ACCESS_TOKEN=...
BUFFER_PROFILE_IDS=...   # comma-separated profile IDs for LinkedIn + others

# App settings
BACKEND_PORT=8000
CHROMA_PERSIST_DIR=./chroma_db
SQLITE_DB_PATH=./campaign_agent.db
